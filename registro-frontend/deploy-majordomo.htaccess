RewriteEngine On
RewriteBase /registro/
AcceptPathInfo On

# Force HTTPS using the proxy header, since Apache sits behind a TLS-terminating
# frontend and its own %{HTTPS} var doesn't reflect the real scheme.
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Let requests targeting proxy-api.php (including its PATH_INFO suffix,
# e.g. proxy-api.php/api/v1/auth/login) reach the PHP script untouched.
RewriteRule ^proxy-api\.php(/.*)?$ proxy-api.php [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Missing static files (e.g. an old hashed chunk requested by a tab still
# running a previous build) must 404, not fall back to index.html: Safari
# refuses an HTML response as a module script and the navigation dies
# silently instead of triggering the router's reload-on-chunk-error path.
RewriteRule ^assets/ - [R=404,L]
RewriteCond %{REQUEST_URI} \.[A-Za-z0-9]+$
RewriteRule ^ - [R=404,L]

RewriteRule ^ index.html [L]

# The app shell and service worker must always be revalidated, otherwise a
# stale copy keeps pointing browsers at chunk hashes that no longer exist.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
